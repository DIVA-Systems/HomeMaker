name: homemaker
description: HomeMaker — intuitive interior design for phone and tablet.
publish_to: "none"
version: 0.1.0+1

environment:
  sdk: ^3.5.0

dependencies:
  flutter:
    sdk: flutter
  cupertino_icons: ^1.0.8
  collection: ^1.18.0
  archive: ^3.6.1
  path: ^1.9.0
  path_provider: ^2.1.4
  shared_preferences: ^2.3.2
  uuid: ^4.5.1
  vector_math: ^2.1.4
  google_fonts: ^6.2.1
  flutter_riverpod: ^2.5.1
  xml: ^6.5.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^4.0.0

flutter:
  uses-material-design: true
  assets:
    - assets/catalog/
    - assets/catalog/icons/
    - assets/catalog/models/
    - assets/branding/
