#!/usr/bin/env bash
set -euo pipefail
SDK="/Users/kira/Flutter/flutter"
# Pre-write stamp into real cache via python with open - may still fail
# Instead intercept by copying update script to tmp and monkeypatch via BASH
VERSION=$(cat "$SDK/bin/internal/engine.version" 2>/dev/null || echo "unknown")
# Write stamp using a no-op if denied
( echo "$VERSION" > "$SDK/bin/cache/engine.stamp" ) 2>/dev/null || true
( echo "" > "$SDK/bin/cache/engine.realm" ) 2>/dev/null || true
# If stamp missing, create writable overlay by replacing the update script temporarily
UPD="$SDK/bin/internal/update_engine_version.sh"
if ! test -w "$SDK/bin/cache/engine.stamp" 2>/dev/null; then
  # Run dart flutter_tools directly, skipping the bash entry that calls update
  exec "$SDK/bin/cache/dart-sdk/bin/dart" "$SDK/bin/cache/flutter_tools.snapshot" "$@"
fi
exec "$SDK/bin/flutter" "$@"
